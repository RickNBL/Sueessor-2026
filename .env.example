# Configure antes de iniciar. Não use credenciais reais em arquivos versionados.
ADMIN_USERNAME=editor
ADMIN_PASSWORD=SUBSTITUA_POR_UMA_SENHA_LONGA_E_UNICA
SESSION_COOKIE_SECURE=false
DATA_DIR=./data
UPLOAD_DIR=./uploads
# Se hospedar sob um domínio próprio, configure HTTPS e SESSION_COOKIE_SECURE=true.

# Na Vercel, defina no dashboard (não versionar credenciais):
# DATABASE_URL=postgresql://usuario:senha@host/dbname?sslmode=require
# BLOB_READ_WRITE_TOKEN=...
